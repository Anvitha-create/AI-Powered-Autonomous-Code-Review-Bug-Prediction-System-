# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_API_BASE=https://api.github.com

# Model Configuration
MODEL_PATH=./models
CODEBERT_MODEL=microsoft/codebert-base
DEVICE=cuda

# XGBoost Configuration
XGBOOST_MODEL_PATH=./models/xgboost_model.pkl
XGBOOST_THRESHOLD=0.5

# GNN Configuration
GNN_HIDDEN_DIM=128
GNN_NUM_LAYERS=3

# LSTM Configuration
LSTM_HIDDEN_DIM=256
LSTM_NUM_LAYERS=2

# Multi-Agent RL Configuration
NUM_AGENTS=5
LEARNING_RATE=0.001
GAMMA=0.99

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/code_review.log

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False